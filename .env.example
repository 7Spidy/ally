# Copy to .env.local (dev) or set in Vercel. No values are committed.

NEXT_PUBLIC_SUPABASE_URL=
# Publishable (sb_publishable_...) or legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Secret (sb_secret_...) or legacy service-role key.
SUPABASE_SECRET_KEY=
# https://ally.redream.in in prod
NEXT_PUBLIC_SITE_URL=
# Real key in prod; Cloudflare test key 1x00000000000000000000AA in Preview/dev
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# B2 live chat. Server only. Same key on Production and Preview.
LLM_API_KEY=
# Provider model id (Groq: qwen/qwen3.8-27b). Unset defaults to xAI grok-4.20-0309-non-reasoning
LLM_MODEL=
# Provider endpoint (Groq: https://api.groq.com/openai/v1). Unset defaults to https://api.x.ai/v1; E2E points it at /api/test/xai-mock
LLM_BASE_URL=
# Bearer secret for /api/cron/vault; also stored in Supabase Vault as cron_secret
CRON_SECRET=

# E2E ONLY. E2E_MOCKS=1 enables /api/test/xai-mock; never set it on Vercel.
E2E_MOCKS=
# E2E ONLY. NEVER set these on Vercel: the bypass skips the captcha and
# ALLY_E2E enables the anonymous-session test route.
NEXT_PUBLIC_TURNSTILE_BYPASS=
ALLY_E2E=
# Optional request shape, per provider. Groq + Qwen3.8 uses reasoning off:
# LLM_RESPONSE_FORMAT=json_schema|json_object  (Groq gpt-oss needs json_object)
# LLM_MAX_TOKENS_PARAM=max_tokens|max_completion_tokens
# LLM_MAX_TOKENS=400  overrides the 500 default; 400 suits reasoning off (observed max output is 159 tokens)
# LLM_REASONING_EFFORT=none|low|medium|high
# LLM_STRICT=false
