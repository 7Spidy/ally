# Copy to .env.local (dev) or set in Vercel. No values are committed.

NEXT_PUBLIC_SUPABASE_URL=
# Publishable (sb_publishable_...) or legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Secret (sb_secret_...) or legacy service-role key.
SUPABASE_SECRET_KEY=
# https://ally.redream.in in prod
NEXT_PUBLIC_SITE_URL=
# Real key in prod; Cloudflare test key 1x00000000000000000000AA in Preview/dev
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# B3 live chat. Server only. Same key on Production and Preview. Paste the key straight into Vercel; never commit it.
LLM_API_KEY=
# Unset defaults to deepseek-v4-pro
LLM_MODEL=
# Unset defaults to https://api.deepseek.com; E2E points it at /api/test/llm-mock
LLM_BASE_URL=
# Bearer secret for /api/cron/vault; also stored in Supabase Vault as cron_secret
CRON_SECRET=

# E2E ONLY. E2E_MOCKS=1 enables /api/test/llm-mock; never set it on Vercel.
E2E_MOCKS=
# E2E ONLY. NEVER set these on Vercel: the bypass skips the captcha and
# ALLY_E2E enables the anonymous-session test route.
NEXT_PUBLIC_TURNSTILE_BYPASS=
ALLY_E2E=
# Optional request shape (DeepSeek V4 Pro defaults shown):
# LLM_THINKING=disabled|enabled  always sent as thinking.type; enabled needs reasoning_content echoed back
# LLM_RESPONSE_FORMAT=json_object|json_schema  (DeepSeek supports json_object only)
# LLM_MAX_TOKENS_PARAM=max_tokens|max_completion_tokens
# LLM_MAX_TOKENS=400  overrides the 500 default
