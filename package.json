{
  "name": "ally",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "e2e:env": "node scripts/e2e-env.mjs",
    "llm:diagnose": "node scripts/run-ts.mjs scripts/llm-diagnose.ts",
    "eval:persona": "node scripts/eval-persona.mjs",
    "eval:ira": "node scripts/eval-persona.mjs --persona F01",
    "assets:first-run": "node scripts/build-first-run-assets.mjs",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:icons": "node scripts/generate-android-icons.mjs && node scripts/generate-android-splash.mjs",
    "android:build": "cd android && gradlew.bat assembleDebug",
    "android:bundle": "cd android && gradlew.bat bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "next": "15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.25",
    "sharp": "^0.35.4",
    "supabase": "^2.117.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
